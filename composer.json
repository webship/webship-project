{
    "name": "drupal/webship_project",
    "description": "Project template for the webship.co Portal site",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://webship.co",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://app.slack.com/client/T06GX3JTS/C7MAHMJRE",
        "issues": "http://drupal.org/project/issues/webship",
        "source": "http://cgit.drupalcode.org/webship"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Webship",
            "homepage": "https://webship.co",
            "role": "Maintainer"
        }
    ],
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    },
    "require": {
        "composer/installers": "~2",
        "cweagans/composer-patches": "~2.0",
        "drupal/core": "^11.4 || ^12",
        "drupal/core-composer-scaffold": "^11.4 || ^12",
        "drupal/webship_portal": "~1.0",
        "drupal/webship_starter": "~1.0",
        "drupal/website_starter": "~1.0",
        "drush/drush": "^13.7 || ^14",
        "mglaman/composer-drupal-lenient": "^2.0",
        "oomphinc/composer-installers-extender": "~2.0",
        "webship/patches": "~12.0",
        "webship/webship": "~12.0"
    },
    "require-dev": {
        "drupal/coder": "^8.3",
        "php-parallel-lint/php-parallel-lint": "^1.3",
        "mglaman/phpstan-drupal": "^1.3",
        "phpstan/phpstan-deprecation-rules": "^1.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "config": {
        "platform": {
            "php": "8.3"
        },
        "bin-dir": "bin/",
        "secure-http": false,
        "optimize-autoloader": true,
        "preferred-install": {
            "drupal/core": "dist"
        },
        "allow-plugins": {
            "composer/installers": true,
            "symplify/vendor-patches": true,
            "cweagans/composer-configurable-plugin": true,
            "cweagans/composer-patches": true,
            "oomphinc/composer-installers-extender": true,
            "drupal/core-composer-scaffold": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "mglaman/composer-drupal-lenient": true,
            "symfony/runtime": true,
            "webship/patches": true
        }
    },
    "extra": {
        "drupal-scaffold": {
            "allowed-packages": [
                "drupal/core",
                "webship/webship"
            ],
            "gitignore": true,
            "locations": {
                "web-root": "web/"
            }
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/ai",
                "drupal/ai_agents",
                "drupal/ai_assistant_api",
                "drupal/ai_chatbot",
                "drupal/ai_content_suggestions",
                "drupal/ai_image_alt_text",
                "drupal/ai_logging",
                "drupal/ai_penpot",
                "drupal/ai_playwright",
                "drupal/ai_provider_anthropic",
                "drupal/ai_provider_huggingface",
                "drupal/ai_provider_ollama",
                "drupal/ai_provider_openai",
                "drupal/ai_provider_xai",
                "drupal/ai_translate",
                "drupal/antibot",
                "drupal/autocomplete_deluxe",
                "drupal/automatic_updates",
                "drupal/better_exposed_filters",
                "drupal/captcha",
                "drupal/coffee",
                "drupal/config_filter",
                "drupal/config_ignore",
                "drupal/config_import_single",
                "drupal/config_rewrite",
                "drupal/config_split",
                "drupal/config_update",
                "drupal/config_update_ui",
                "drupal/consumers",
                "drupal/crop",
                "drupal/ctools",
                "drupal/dashboards",
                "drupal/display_builder",
                "drupal/display_builder_entity_view",
                "drupal/display_builder_page_layout",
                "drupal/display_builder_ui",
                "drupal/display_builder_views",
                "drupal/drupical",
                "drupal/easy_breadcrumb",
                "drupal/easy_encryption",
                "drupal/editor_advanced_link",
                "drupal/embed",
                "drupal/entity_embed",
                "drupal/field_group",
                "drupal/field_validation",
                "drupal/flood_control",
                "drupal/focal_point",
                "drupal/friendlycaptcha",
                "drupal/gemini_provider",
                "drupal/google_analytics",
                "drupal/google_tag",
                "drupal/honeypot",
                "drupal/inline_entity_form",
                "drupal/jsonapi_extras",
                "drupal/key",
                "drupal/klaro",
                "drupal/login_emailusername",
                "drupal/manage_display",
                "drupal/media_directories_editor",
                "drupal/media_directories_ui",
                "drupal/media_remote_audio",
                "drupal/media_remote_image",
                "drupal/metatag",
                "drupal/openapi",
                "drupal/openapi_jsonapi",
                "drupal/openapi_rest",
                "drupal/openapi_ui",
                "drupal/openapi_ui_swagger",
                "drupal/pathauto",
                "drupal/recaptcha_v3",
                "drupal/redirect",
                "drupal/restui",
                "drupal/sam",
                "drupal/schema_metatag",
                "drupal/schemata",
                "drupal/schemata_json_schema",
                "drupal/seckit",
                "drupal/security_review",
                "drupal/shield",
                "drupal/simple_oauth",
                "drupal/smart_trim",
                "drupal/tagify",
                "drupal/token",
                "drupal/token_filter",
                "drupal/tracker",
                "drupal/user_redirect",
                "drupal/view_password",
                "drupal/views_bulk_edit",
                "drupal/views_bulk_operations",
                "drupal/webform",
                "drupal/xmlsitemap",
                "drupal/yoast_seo"
            ]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:bower-asset",
                "type:npm-asset"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ]
        },
        "installer-types": [
            "bower-asset",
            "npm-asset"
        ],
        "drupal-libraries": {
            "library-directory": "web/libraries",
            "libraries": []
        },
        "enable-patching": true,
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {},
        "composer-patches": {
            "allowed-dependency-patches": [
                "webship/patches",
                "webship/drupal-patches"
            ]
        },
        "drupal-recipe-unpack": {
            "ignore": [
                "drupal/webship_portal",
                "drupal/webship_starter",
                "drupal/website_starter"
            ]
        }
    }
}
