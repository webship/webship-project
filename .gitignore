# Ignore directories generated by Composer
/drush/contrib/
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore sensitive information
/web/sites/*/settings.php
/web/sites/*/settings.local.php

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest

# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files as they are personal
/.env
/nbproject
/nbproject/
/nbproject/private/

# Ignore local gitlab-ci-local runtime + sidecar config.
# The canonical pipeline lives in .gitlab-ci.yml; the local CI is per-developer.
.gitlab-ci-local/
.gitlab-ci-local.yml
.cucumber.js.bak
bin/
node_modules/
/.editorconfig
/.gitattributes

# Composer/Yarn build artifacts generated locally by `composer install` /
# `yarn install`. NOTE: for reproducible installs, the release branches/tags
# commit the lock files (composer.lock, patches.lock.json, yarn.lock).
build.env
.pnp.*
.yarn/
# Generated test/CI report artifacts (produced by lint + webship-js jobs)
junit.xml
gl-codequality.json
_eslint.patch
.playwright-mcp/
